{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "e2e:open": "cypress open",
    "e2e:run": "cypress run",
    "e2e:run:coverage": "node scripts/e2e-run.mjs",
    "coverage:report": "nyc report --reporter=text-summary --reporter=lcov",
    "test": "vitest run",
    "audit": "pnpm audit --audit-level high --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.3",
    "@eslint/js": "^9.39.4",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/node": "^24.12.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "cypress": "13.17.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "nyc": "^15.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.2.1",
    "vite-plugin-istanbul": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.1.0": "^1.1.20",
      "brace-expansion@^5.0.0": "^5.0.11",
      "browserslist@<=4.28.6": ">=4.28.7",
      "fast-uri@>=3.0.0 <3.1.7": ">=3.1.7 <4.0.0",
      "form-data": "^4.0.6",
      "js-yaml@^3.14.0": "^3.15.2",
      "js-yaml@^4.1.0": "^4.3.2",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "tmp": "^0.2.6"
    }
  }
}
