{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rk_wcfr.config.schema.json",
  "title": "rk_wcfr config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "camera",
    "recognition",
    "dnn",
    "http",
    "poster",
    "log",
    "ui",
    "display"
  ],
  "properties": {
    "schemaVersion": { "type": "number", "minimum": 1, "maximum": 1 },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferredDeviceId", "width", "height", "fps"],
      "properties": {
        "preferredDeviceId": { "type": "string" },
        "width": { "type": "number", "minimum": 1, "maximum": 8192 },
        "height": { "type": "number", "minimum": 1, "maximum": 8192 },
        "fps": { "type": "number", "minimum": 1, "maximum": 240 }
      }
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cascadePath", "databasePath", "arcFaceModelPath", "minFaceSizePx", "identifyThreshold", "identifyThresholdArcFace", "enrollSamples"],
      "properties": {
        "cascadePath": { "type": "string" },
        "databasePath": { "type": "string" },
        "arcFaceModelPath": { "type": "string" },
        "arcFaceInputName": { "type": "string" },
        "arcFaceOutputName": { "type": "string" },
        "minFaceSizePx": { "type": "number", "minimum": 10, "maximum": 10000 },
        "identifyThreshold": { "type": "number", "minimum": 1, "maximum": 64 },
        "identifyThresholdArcFace": { "type": "number", "minimum": 0, "maximum": 1 },
        "enrollSamples": { "type": "number", "minimum": 1, "maximum": 1000 }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["throttleMode", "intervalMs"],
      "properties": {
        "throttleMode": { "type": "string" },
        "intervalMs": { "type": "number", "minimum": 80, "maximum": 500 }
      }
    },
    "dnn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enable",
        "modelPath",
        "configPath",
        "inputWidth",
        "inputHeight",
        "scale",
        "meanB",
        "meanG",
        "meanR",
        "swapRB",
        "confThreshold",
        "backend",
        "target"
      ],
      "properties": {
        "enable": { "type": "boolean" },
        "modelPath": { "type": "string" },
        "configPath": { "type": "string" },
        "inputWidth": { "type": "number", "minimum": 1, "maximum": 8192 },
        "inputHeight": { "type": "number", "minimum": 1, "maximum": 8192 },
        "scale": { "type": "number" },
        "meanB": { "type": "number" },
        "meanG": { "type": "number" },
        "meanR": { "type": "number" },
        "swapRB": { "type": "boolean" },
        "confThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "backend": { "type": "number" },
        "target": { "type": "number" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detection": { "type": "string" },
        "recognition": { "type": "string" },
        "backend": { "type": "string" },
        "detectorBackend": { "type": "string" },
        "recognitionBackend": { "type": "string" },
        "autoFallback": { "type": "boolean" },
        "int8Enabled": { "type": "boolean" }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enable", "port"],
      "properties": {
        "enable": { "type": "boolean" },
        "port": { "type": "number", "minimum": 1, "maximum": 65535 }
      }
    },
    "poster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enable", "postUrl", "throttleMs", "backoffMinMs", "backoffMaxMs"],
      "properties": {
        "enable": { "type": "boolean" },
        "postUrl": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["v", "alg", "nonce", "ciphertext", "tag"],
              "properties": {
                "v": { "type": "number", "minimum": 1, "maximum": 1 },
                "alg": { "type": "string", "enum": ["AES-256-GCM"] },
                "nonce": { "type": "string" },
                "ciphertext": { "type": "string" },
                "tag": { "type": "string" }
              }
            }
          ]
        },
        "throttleMs": { "type": "number", "minimum": 0, "maximum": 3600000 },
        "backoffMinMs": { "type": "number", "minimum": 50, "maximum": 3600000 },
        "backoffMaxMs": { "type": "number", "minimum": 50, "maximum": 3600000 }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logDir", "maxFileBytes", "maxRollFiles"],
      "properties": {
        "logDir": { "type": "string" },
        "maxFileBytes": {
          "type": "number",
          "minimum": 1024,
          "maximum": 1073741824,
          "description": "单日志文件最大字节数的声明值。运行期会按三份文件集（recognition.csv、recognition.jsonl、event_log.jsonl）合计 512 MiB 的总预算静默下调（单份均分额约 170.67 MiB，故本键生效上界约 85.33 MiB）；GET 返回的是钳后生效值，可能小于此声明值。⚠️ 下调的可见性**按调用路径分三种，勿一概而论**（原 description 只写「只告警、不拒绝」，仅对启动装载成立）：① 启动装载（initialize 读 config.json）——只告警、不拒绝，configStatus 转 degraded 且告警文本经 configWarning 暴露，磁盘原值不改（故告警每次启动复现，重启不自愈）；② 热重载（reloadFromDisk，config.json 被外部修改触发）——同样只告警、不拒绝，但告警只并入内部 outErr（生产调用方忽略）⇒ 用户不可见、**不**产生 degraded，且该路径**不写盘**；③ PUT /api/v1/settings——**不产生告警、也不产生 degraded**，但提交会把**钳后的生效值**（如 maxRollFiles=1000 在默认 maxFileBytes 下变为 16）**静默写回** config.json，即「静默收敛到生效值」。三种路径下 maximum 都保持契约值不变。"
        },
        "maxRollFiles": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000,
          "description": "滚动保留日志文件数的声明值。运行期会按同一总预算静默下调：上界 = 单份均分额（约 170.67 MiB）/ 钳后的 maxFileBytes − 1（默认 10 MiB 时为 16）；GET 返回的是钳后生效值。⚠️ 下调的可见性同 maxFileBytes，**按路径分三种**：启动装载触发 configStatus=degraded + configWarning（磁盘原值不改）；热重载只并入内部 outErr（用户不可见、不写盘）；PUT /api/v1/settings 则把钳后值**静默写回** config.json（无告警、无 degraded）。"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowWidth", "windowHeight", "previewScaleMode"],
      "properties": {
        "windowWidth": { "type": "number", "minimum": 320, "maximum": 7680 },
        "windowHeight": { "type": "number", "minimum": 240, "maximum": 4320 },
        "previewScaleMode": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputIndex",
        "width",
        "height",
        "refreshNumerator",
        "refreshDenominator",
        "vsync",
        "swapchainBuffers",
        "fullscreen",
        "allowSystemModeSwitch",
        "enableSRGB",
        "gamma",
        "colorTempK",
        "aaSamples",
        "anisoLevel"
      ],
      "properties": {
        "outputIndex": { "type": "number", "minimum": 0, "maximum": 32 },
        "width": { "type": "number", "minimum": 0, "maximum": 7680 },
        "height": { "type": "number", "minimum": 0, "maximum": 4320 },
        "refreshNumerator": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "refreshDenominator": { "type": "number", "minimum": 1, "maximum": 1000000 },
        "vsync": { "type": "boolean" },
        "swapchainBuffers": { "type": "number", "minimum": 1, "maximum": 8 },
        "fullscreen": { "type": "boolean" },
        "allowSystemModeSwitch": { "type": "boolean" },
        "enableSRGB": { "type": "boolean" },
        "gamma": { "type": "number", "minimum": 0.1, "maximum": 10 },
        "colorTempK": { "type": "number", "minimum": 1000, "maximum": 20000 },
        "aaSamples": { "type": "number", "minimum": 1, "maximum": 16 },
        "anisoLevel": { "type": "number", "minimum": 1, "maximum": 16 }
      }
    },
    "acceleration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enableOpenCL", "enableLibyuv", "enableMpp", "enableQualcomm"],
      "properties": {
        "enableOpenCL": { "type": "boolean" },
        "enableLibyuv": { "type": "boolean" },
        "enableMpp": { "type": "boolean" },
        "enableQualcomm": { "type": "boolean" }
      }
    }
  }
}

