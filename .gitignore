models/android/**/*.bin
models/android/**/*.param
# 任务10A2：stageFaceModels 的目标 assets 目录忽略——防止本地 stage 后二进制混入提交流（入库）
app/src/main/assets/face_models/
deps/WIDER_train/*
!deps/WIDER_train/.gitkeep
deps/insightface/*
!deps/insightface/.gitkeep
# 可复用缓存根目录（cache/）：构建目录、本机包装脚本、需跨会话保留的验证产物。
# 内容一律不入库，既含可重建产物，也含未入库脚本及唯一证据；忽略不等于可删除。
# 仅保留说明文件 cache/README.md 入库，记录分类、恢复方式与清理边界。
cache/*
!cache/README.md

